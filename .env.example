# === Gemini Live API ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# === LiveKit SFU & SIP Bridge ===
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# === WhatsApp Business Calling API (Meta Cloud API) ===
WHATSAPP_ACCESS_TOKEN=your_meta_graph_api_token
WHATSAPP_PHONE_NUMBER_ID=your_waba_phone_number_id
WHATSAPP_VERIFY_TOKEN=aureum_voice_verify_2026
WHATSAPP_CALLING_MODE=sip # "sip" (wa.meta.vc) or "webrtc_webhook"

# === Native SIP Trunk (Twilio / Telnyx / Asterisk / FreeSWITCH) ===
SIP_TRUNK_HOST=sip.yourprovider.com
SIP_TRUNK_USERNAME=your_sip_username
SIP_TRUNK_PASSWORD=your_sip_password
SIP_CALLER_ID=+15550001234

# === Control Panel ===
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/telemetry
